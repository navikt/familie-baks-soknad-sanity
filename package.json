{
  "name": "baks-soknad-cms",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.0",
  "description": "Sanity (cms) for søknad til kontantstøtte",
  "main": "package.json",
  "author": "Team BAKS",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "test": "echo \"No test specified.\"",
    "lint": "eslint './**/*.{js,ts,tsx}'",
    "lint:fix": "eslint './**/*.{js,ts,tsx}' --fix",
    "prettier": "prettier --check './**/*.{js,jsx,ts,tsx,json,css}'",
    "prettier:fix": "prettier --write './**/*.{js,jsx,ts,tsx,json,css}'",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm typecheck && pnpm lint && pnpm prettier"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/client": "8.0.0",
    "@sanity/icons": "5.2.1",
    "@sanity/types": "6.11.0",
    "@sanity/ui": "3.5.4",
    "@sanity/vision": "6.9.1",
    "groq": "6.9.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanity": "6.9.1",
    "styled-components": "6.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sanity/eslint-config-studio": "6.0.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.1",
    "globals": "17.4.0",
    "prettier": "3.9.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.59.0",
    "vite": "8.2.2"
  }
}
